#!/usr/bin/env python3
import os
import subprocess
import sys
import time
from pathlib import Path

BASE_DIR = Path(__file__).resolve().parent
PYTHON = BASE_DIR / ".venv" / "bin" / "python"
NOTIFIER = BASE_DIR / "lifecycle_notify.py"

runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
lock_dir = Path(os.environ.get("QS_RUN_LOCK", str(runtime / "serpantinum" / "lock")))
LOCK_FILE = lock_dir / "locked"

POLL_SECONDS = 0.25
STABLE_SECONDS = 1.0
RETRY_SECONDS = 10.0


def is_locked():
    return LOCK_FILE.exists()


def main():
    print(f"Watching Serpantinum lock state: {LOCK_FILE}", flush=True)

    # Establish a silent baseline so starting this service sends no false alert.
    current = is_locked()
    candidate = current
    candidate_since = time.monotonic()
    last_attempt = 0.0

    print(f"Initial state: {'locked' if current else 'unlocked'}", flush=True)

    while True:
        time.sleep(POLL_SECONDS)
        observed = is_locked()
        now = time.monotonic()

        if observed != candidate:
            candidate = observed
            candidate_since = now
            continue

        if candidate == current or now - candidate_since < STABLE_SECONDS:
            continue

        if now - last_attempt < RETRY_SECONDS:
            continue

        event = "locked" if candidate else "unlocked"
        print(f"Confirmed state change: {event}", flush=True)

        try:
            result = subprocess.run(
                [str(PYTHON), str(NOTIFIER), event],
                cwd=str(BASE_DIR),
                timeout=12,
                check=False,
            )
            last_attempt = time.monotonic()

            if result.returncode == 0:
                current = candidate
                print(f"Telegram notification delivered: {event}", flush=True)
            else:
                print(
                    f"Notification failed for {event}; will retry.",
                    file=sys.stderr,
                    flush=True,
                )
        except (OSError, subprocess.TimeoutExpired) as exc:
            last_attempt = time.monotonic()
            print(f"Notification error: {exc}; will retry.", file=sys.stderr, flush=True)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
